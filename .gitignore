# =============================================================
#  .gitignore
#
#  原则：**代码和实验数据进仓库，能重跑出来的东西不进。**
#
#  三类必须排除：
#    1. 凭据 —— 提交即泄露，且 Git 历史删不掉
#    2. 大文件 —— 模型权重、二进制，GitHub 会拒收或拖慢克隆
#    3. 个人数据 —— 截图、记忆、日志，与项目无关
# =============================================================

# ---------------------------------------------------------------
# 1. 凭据（最高优先级）
# ---------------------------------------------------------------
# 本机凭据文件。模板见 feishu-bot/config.example.py
feishu-bot/config_local.py
feishu-bot/config.py.private_backup
*.private_backup
.env
.env.*
*.pem
*.key
credentials.json
token.json

# ---------------------------------------------------------------
# 2. 模型权重（体积大，且受各自的许可约束，不该随仓库分发）
# ---------------------------------------------------------------
models/
qwen/model/
*.gguf
*.safetensors
*.safetensors.*
*.bin
*.pt
*.pth
*.onnx
*.ninfer

# ---------------------------------------------------------------
# 3. 引擎二进制（需自行构建）
# ---------------------------------------------------------------
engine/

# ---------------------------------------------------------------
# 4. 个人数据
# ---------------------------------------------------------------
# 截图（可能含桌面内容）
shots/
# 长期记忆 / 图片索引（含用户画像与文件路径）
controller/memory/
# 智能体的历史产物（93 个 task 日志，无出版价值）
controller/artifacts/
# 个人交接文档（含本机路径与私有部署细节）
项目交接与部署说明.md

# ★ 运行时会话状态 —— 最容易漏的一类
#
# 这些文件不含"密码"这类显式特征，所以模式匹配的扫描器抓不到，
# 但内容是**真实对话**：用户的求职城市、职业方向、称呼偏好、
# 以及所有来往消息。属于最私密的一类数据。
#
# 教训：判断"是不是个人数据"不能只看字符串特征，
# 要看**这个文件的用途**——凡是「对话/记忆/会话」类运行状态，一律排除。
controller/history/
controller/summaries/
controller/session.json
controller/think_mode.txt
controller/*.jsonl
# 用户的飞书 open_id（个人标识符）
feishu-bot/owner_open_id.txt
feishu-bot/owner_*.txt
# 运行状态文件的一般形态
*.session.json
session.json

# ---------------------------------------------------------------
# 5. 运行产物
# ---------------------------------------------------------------
*.log
logs/
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 引擎与代理的运行快照
props.json
hash_result.txt
pc.txt
server.log
proxy.log
qwen.log
engine.log

# ---------------------------------------------------------------
# 6. 第三方内容（避免随仓库再分发）
# ---------------------------------------------------------------
*.zip
*.tar.gz
*.tgz
*.7z
skills/wda.zip
grill-me-skill-main.zip

# grill-me 是第三方 skill，**没有 LICENSE 文件**。
# 无授权声明 = 默认保留所有权利，不该随本仓库公开分发。
#   正确做法：在 README 里给出原仓库链接，让读者自己去装。
#   若确实要内置：先向原作者确认授权，或在文件里注明来源与许可。
skills/grill-me/

# ---------------------------------------------------------------
# 7. 测试与调试残留
# ---------------------------------------------------------------
_selftest_stash/
_cleanup_stash/
_*.bat
_trace*.txt

# 一次性迁移脚本：它们体内保存着「脱敏前的旧路径」作为匹配串，
# 任务已完成，无需再进仓库（否则等于把旧路径换个地方又提交了一遍）
experiments/patch_bat_paths.py
experiments/fix_legacy_paths.py

# 各类备份（含脱敏前的原始内容）
*.bak
*.bak2_*
*.bak_*
*.orig
start_kvmem_all.bat.bak*
start_kvmem.ps1.bak

# ---------------------------------------------------------------
# 8. 编辑器 / 系统
# ---------------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------
# 9. 离线实验的临时图（标准答案可重新生成，见 experiments/)
# ---------------------------------------------------------------
experiments/traces/
